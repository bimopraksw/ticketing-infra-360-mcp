# ============================================================================
# Ticketing-Infra-360 MCP Server — environment configuration
# Copy this file to `.env` and fill in real values.
# ============================================================================

# Base URL of the LinkIT360 instance (no trailing slash).
LINKIT_BASE_URL=https://report.linkit360.com

# Login credentials (the MCP logs in by driving the real login form).
# DO NOT put real credentials here — this file is committed. Use your own in .env
LINKIT_EMAIL=you@linkit360.com
LINKIT_PASSWORD=your-password

# ----------------------------------------------------------------------------
# Login form discovery (override only if auto-detection fails).
# Leave blank to let the server auto-detect the standard Laravel login form.
# ----------------------------------------------------------------------------
# Path to the login page (relative to base URL).
LINKIT_LOGIN_PATH=/login
# CSS selectors for the login form fields. Auto-detected if blank.
LINKIT_LOGIN_EMAIL_SELECTOR=
LINKIT_LOGIN_PASSWORD_SELECTOR=
LINKIT_LOGIN_SUBMIT_SELECTOR=
# A URL substring or selector that proves login succeeded (e.g. "/dashboard").
# If blank, success is inferred by "no longer on the login page".
LINKIT_LOGIN_SUCCESS_URL=

# ----------------------------------------------------------------------------
# Browser / session behaviour
# ----------------------------------------------------------------------------
# Run Chromium headless (true) or visible (false — useful for debugging).
LINKIT_HEADLESS=true
# Where to persist the logged-in session (cookies/localStorage).
# Optional — defaults to an absolute path in your home dir: ~/.linkit360/session.json
# Only set this if you want a different location (use an absolute path).
# LINKIT_SESSION_PATH=/Users/you/.linkit360/session.json
# Per-navigation timeout in milliseconds.
LINKIT_TIMEOUT_MS=30000
# Number of retries for transient navigation/network failures.
LINKIT_MAX_RETRIES=2
# Optional locale passed to the browser context.
LINKIT_LOCALE=en-US

# ----------------------------------------------------------------------------
# Seamlessness (all default ON — leave them on for a no-friction experience)
# ----------------------------------------------------------------------------
# When the session expires mid-task, automatically open a real browser window
# so you can solve the captcha and re-login, then continue. Set false to revert
# to the old behaviour (error out and tell you to log in manually).
LINKIT_AUTO_LOGIN=true
# If Chromium is missing, install it automatically in a background process
# (never blocks, never needs a terminal or an app restart).
LINKIT_AUTO_INSTALL_BROWSER=true
# On startup, quietly pull the latest code from GitHub so every user stays up to
# date with zero manual steps. The update applies the next time the app starts.
LINKIT_AUTO_UPDATE=true

# ----------------------------------------------------------------------------
# Ticketing defaults
# ----------------------------------------------------------------------------
# Default ticket priority when the request doesn't specify one. P3 is safe and
# needs no approval; P0/P1/P2 trigger the approval workflow and ask who approves.
LINKIT_DEFAULT_CLASSIFICATION=P3

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# debug | info | warn | error
LINKIT_LOG_LEVEL=info
